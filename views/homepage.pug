doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        a.add-link(href="/update-cobj") Add to this table
        h1 Pets
        table.records
            thead
                tr
                    th Name
                    th Species
                    th Age
            tbody
                if data.length
                    each pet in data
                        tr
                            td #{pet.properties.name}
                            td #{pet.properties.species}
                            td #{pet.properties.age}
                else
                    tr
                        td(colspan="3") No pets yet.
